# Environment Configuration for PRODUCTION
# Copy this to Railway Variables in production environment
# ⚠️ ONLY USE WHEN READY FOR PRODUCTION

# Environment
NODE_ENV=production
PORT=3000

# Database (Railway generates this automatically - DIFFERENT from staging)
# DATABASE_URL=postgresql://postgres:xxx@different-host.rlwy.net:xxxxx/railway

# API Configuration
API_VERSION=v1
CORS_ORIGIN=https://your-frontend-domain.com  # ⚠️ CHANGE THIS - Be specific!

# Logging (less verbose in production)
LOG_LEVEL=warn  # Only warnings and errors
LOG_FORMAT=json

# Rate Limiting (stricter in production)
RATE_LIMIT_MAX_REQUESTS=50  # More restrictive
RATE_LIMIT_PAYMENT_MAX_REQUESTS=5  # More restrictive for payments
RATE_LIMIT_WINDOW_MS=60000

# Wompi PRODUCTION Configuration
# ⚠️ IMPORTANT: Get these from Wompi after approval
# ⚠️ DO NOT use test keys in production!
WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_prod_XXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_prod_XXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_KEY=prod_integrity_XXXXXXXXXXXXXXXXXXXXXXXXXX

# Notes:
# - This is for PRODUCTION environment only
# - Uses Wompi PRODUCTION (real payments!)
# - CORS is restrictive (specific domain)
# - Logs are minimal (warn level only)
# - Rate limits are strict
# - Requires Wompi production approval
# - Use separate database from staging
