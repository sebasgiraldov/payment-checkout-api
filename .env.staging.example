# Environment Configuration for STAGING
# Copy this to Railway Variables in staging environment

# Environment
NODE_ENV=staging
PORT=3000
BASE_URL=https://payment-checkout-api-staging.up.railway.app

# Database (Railway generates this automatically)
# DATABASE_URL=postgresql://postgres:xxx@hopper.proxy.rlwy.net:xxxxx/railway

# API Configuration
API_VERSION=v1
CORS_ORIGIN=*

# Logging (verbose for debugging in staging)
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting (permissive for testing)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PAYMENT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Wompi SANDBOX Configuration (for testing)
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_your_public_key_here
WOMPI_PRIVATE_KEY=prv_test_your_private_key_here
WOMPI_INTEGRITY_KEY=test_integrity_your_integrity_key_here

# Notes:
# - This is for STAGING environment only
# - Uses Wompi SANDBOX for testing
# - CORS is permissive (*) for easier testing
# - Logs are verbose (info level)
# - Rate limits are relaxed for testing
